{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FreshRoute AI (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "env": { "FRESHROUTE_DEBUG": "1" },
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", "."],
      "console": "integratedTerminal"
    }
  ]
}
